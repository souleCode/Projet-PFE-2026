    """Fonction principale d'exécution"""
    print("\n" + "🎯"*35)
    print("   SYSTÈME D'ENTRAÎNEMENT ET BENCHMARK POUR DÉTECTION D'EPI")
    print("🎯"*35 + "\n")
    
    # Vérifier que les données sont disponibles
    if data_yaml_path is None:
        print("❌ Impossible de continuer sans données!")
        print("\n📝 Checklist avant de continuer:")
        print("   ☐ Créer un compte Roboflow")
        print("   ☐ Uploader vos données (Train/Test/Val)")
        print("   ☐ Mettre à jour Config.ROBOFLOW_API_KEY")
        print("   ☐ Mettre à jour Config.WORKSPACE_NAME")
